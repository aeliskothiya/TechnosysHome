# ======================================
# Global Ignore
# ======================================
.DS_Store
Thumbs.db

# ======================================
# Environment Files (VERY IMPORTANT)
# ======================================
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
*.env

# ======================================
# Node Modules (Client + Server)
# ======================================
node_modules/
*/node_modules/

# ======================================
# Build / Output Folders
# ======================================
dist/
build/
.Client/dist/
.Client/build/
.Server/dist/
.Server/build/

# ======================================
# Logs
# ======================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
debug.log

# ======================================
# Server Uploads (DON'T UPLOAD USER FILES)
# ======================================
Server/uploads/
Server/uploads/**

# If you want to upload images manually later (optional):
# !Server/uploads/readme.md

# ======================================
# Cache & Temp Files
# ======================================
.cache/
.tmp/
coverage/

# Vite
Client/.vite/

# ======================================
# IDE Files
# ======================================
.vscode/
.idea/

# ======================================
# Misc
# ======================================
package-lock.json
pnpm-lock.yaml
